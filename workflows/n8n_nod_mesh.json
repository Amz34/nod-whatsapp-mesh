    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst payload = (.body && typeof .body === \"object\") ? .body : ;\nconst isPollUpdate = payload.pollVote !== undefined || payload.selectedOption !== undefined;\nconst text = String(payload.message || payload.text || \"\").trim().toLowerCase();\nconst chatId = String(payload.chatId || payload.senderId || \"966574268856@s.whatsapp.net\");\n\nlet action = \"unknown\";\nif (isPollUpdate) {\n    action = payload.selectedOption === 0 ? \"poll_approve\" : \"poll_reject\";\n} else if (text.startsWith(\"audit\")) {\n    action = \"audit_sweep\";\n} else if (text.startsWith(\"ask\")) {\n    action = \"graph_query\";\n} else if (text.startsWith(\"browse\")) {\n    action = \"computer_use\";\n} else {\n    action = \"help_status\";\n}\n\nreturn [{ json: { action, isPollUpdate, rawText: text, chatId, timestamp: new Date().toISOString() } }];\n"
      },
      "id": "21de4d08-dc8f-4e5e-8336-2cddeff56401",
      "name": "Triage Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
